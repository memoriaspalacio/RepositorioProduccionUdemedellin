MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2066619691}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edde002dccf575043a7d2437a224c64f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UdeM.Portafolio.MenuPortafolio
  entradas:
  - titulo: Tres formas de morir
    categoria: VFX
    descripcion: 'Cada enemigo muere segun de que esta hecho: el esqueleto se deshace
      en polvo, las monjas y el sacerdote arden y el angel de piedra revienta en
      rocas.'
    ruta: Assets/_Juego Actual/Portafolio/Escenas/01_VFX_Muertes.unity
    miniatura: {fileID: 2800000, guid: 6aad46eb1478e4740820e5f798bb76b8, type: 3}
  - titulo: El kit del sacerdote
    categoria: VFX
    descripcion: Cruces que flotan y atacan, un escudo divino que se agrieta, el
      descenso al infierno, la invocacion y el fuego de las monjas.
    ruta: Assets/_Juego Actual/Portafolio/Escenas/02_VFX_Sacerdote.unity
    miniatura: {fileID: 2800000, guid: 07a9bc36ba83e444fac12f4ef86f7815, type: 3}
  - titulo: Animaciones de personajes
    categoria: Animacion
    descripcion: Ciclos, ataques, reacciones y muertes de Arabella, el esqueleto,
      la monja, el sacerdote y el angel.
    ruta: Assets/_Juego Actual/Portafolio/Escenas/03_Animaciones.unity
    miniatura: {fileID: 2800000, guid: 2cc9cf57bcb424f429567e1ec32c90d8, type: 3}
  - titulo: 'Luz y bake: Cementerio'
    categoria: Iluminacion
    descripcion: 'Recorre el nivel y enciende o apaga cada capa: lightmaps horneados,
      luces, reflejos, niebla, particulas y postproceso.'
    ruta: Assets/_Juego Actual/Portafolio/Escenas/04_Iluminacion_Cementerio.unity
    miniatura: {fileID: 2800000, guid: 628137575485d074cb68a508077e8830, type: 3}
  - titulo: 'Luz y bake: Iglesia'
    categoria: Iluminacion
    descripcion: Haces de luz, niebla y bake de la iglesia, capa por capa y con recorrido
      libre.
    ruta: Assets/_Juego Actual/Portafolio/Escenas/04_Iluminacion_Iglesia.unity
    miniatura: {fileID: 2800000, guid: 103e2d94ba44c3243b021c78b39987ca, type: 3}
  - titulo: 'Luz y bake: Mazmorra'
    categoria: Iluminacion
    descripcion: Antorchas, ojos que brillan y bake de la mazmorra, capa por capa
      y con recorrido libre.
    ruta: Assets/_Juego Actual/Portafolio/Escenas/04_Iluminacion_Mazmorra.unity
    miniatura: {fileID: 2800000, guid: 8186a02b8b1ea2a4b9fb7218c2791e3c, type: 3}
  - titulo: 'Luz y bake: Crisantia'
    categoria: Iluminacion
    descripcion: Cuadros emisivos, luciernagas y bake de Crisantia, capa por capa
      y con recorrido libre.
    ruta: Assets/_Juego Actual/Portafolio/Escenas/04_Iluminacion_Crisantia.unity
    miniatura: {fileID: 2800000, guid: 82f7d6754128a444f9d44d153484d889, type: 3}
  - titulo: Interfaz y feedback en juego
    categoria: Game feel
    descripcion: 'El HUD real con el ritmo funcionando: corazon, calificaciones,
      pista, dano, recompensas y cronometro.'
    ruta: Assets/_Juego Actual/Portafolio/Escenas/05_Interfaz_Feedback.unity
    miniatura: {fileID: 2800000, guid: 3dacd3b135df6934699c2adcdbccb5e5, type: 3}
  - titulo: Interfaz aislada
    categoria: UI
    descripcion: Cada elemento de la interfaz solo y en grande sobre un fondo neutro,
      con el ritmo de verdad debajo.
    ruta: Assets/_Juego Actual/Portafolio/Escenas/06_Interfaz_Aislada.unity
    miniatura: {fileID: 2800000, guid: d7f74d901b6da534380b89b1afd7d097, type: 3}
  - titulo: Arte del equipo
    categoria: Arte
    descripcion: Arte 2D e interfaz, texturas pintadas, props de los niveles y personajes
      modelados, con vista de arcilla.
    ruta: Assets/_Juego Actual/Portafolio/Escenas/07_Arte_Equipo.unity
    miniatura: {fileID: 2800000, guid: 9917070f75844d74b8844682e25cee43, type: 3}
  - titulo: Sistema de grid
    categoria: Arte tecnico
    descripcion: 'El suelo procedural con el grid dentro del shader: estilos, integracion,
      patrones, pulso con el beat y casillas.'
    ruta: Assets/_Juego Actual/Portafolio/Escenas/08_Sistema_Grid.unity
    miniatura: {fileID: 2800000, guid: 68f0f18d7de6f2d468ce25bf8597b63b, type: 3}
  fuenteTitulos: {fileID: 11400000, guid: dba854f04b7d98b4f8fc5709b8766694, type: 2}
  fuenteTexto: {fileID: 11400000, guid: dba854f04b7d98b4f8fc5709b8766694, type: 2}
